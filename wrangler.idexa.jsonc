{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A second copy of the app, at iradio.idexa.app in the "Nafish Ahmed" Cloudflare
  // account, with its own Durable Objects allowance. Deployed with `npm run deploy:idexa`.
  // Everything but the name, account and address must stay the same as wrangler.jsonc.
  "name": "iradio",
  "account_id": "d432cc0bfc8bf14ee77375746659e504",
  "routes": [{ "pattern": "iradio.idexa.app", "custom_domain": true }],
  "workers_dev": false,
  "main": "worker/main.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
