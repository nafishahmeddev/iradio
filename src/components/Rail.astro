---
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const places = [
  { action: 'top', kind: 'top', icon: 'top', label: 'Top' },
  { action: 'country', kind: 'country', icon: 'globe', label: 'Countries' },
  { action: 'genre', kind: 'genre', icon: 'genres', label: 'Genres' },
  { action: 'favorites', kind: 'saved', icon: 'heart', label: 'Saved' },
  { action: 'rooms', kind: 'rooms', icon: 'rooms', label: 'Rooms' },
] as const;
---

<nav class="rail" aria-label="Browse stations">
  <p class="brand"><Logo size={34} /></p>
  <ul>
    {
      places.map(({ action, kind, icon, label }) => (
        <li>
          <button type="button" class="place" data-action={action} data-kind={kind}>
            <Icon name={icon} size={24} />
            <span class="label">{label}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <a class="maker label muted" href="https://idexa.app" target="_blank" rel="noopener" title="Designed and developed by Idexa">
    by<br />Idexa
  </a>
  <button type="button" class="icon-button" data-action="install" aria-label="Install iRadio" hidden>
    <Icon name="install" />
  </button>
  <button type="button" class="icon-button keys" data-action="help" aria-label="Keyboard shortcuts">
    <Icon name="keyboard" />
  </button>
</nav>

<style>
  .rail {
    grid-area: rail;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: var(--rail);
    padding-block: max(var(--space-4), env(safe-area-inset-top)) var(--space-4);
    border-right: 1px solid var(--line);
  }

  .icon-button[hidden] {
    display: none;
  }

  .maker {
    margin-bottom: var(--space-2);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-align: center;
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .maker:hover {
    color: var(--color-text);
  }

  ul {
    display: grid;
    gap: var(--space-1);
    flex: 1;
    margin-top: var(--space-4);
    align-content: start;
  }

  .place {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    width: var(--rail);
    padding: var(--space-3) 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    transition: color var(--fast) var(--ease);
  }

  .place:focus-visible {
    outline-offset: -6px;
    border-radius: var(--radius-sm);
  }

  .place .label {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .place:hover,
  .place[aria-pressed='true'] {
    color: var(--color-text);
  }

  /* A lit marker on the rail's edge shows where you are. */
  .place::before {
    content: '';
    position: absolute;
    inset: 25% auto 25% 0;
    width: 2px;
    border-radius: 2px;
    background: var(--color-amber);
    scale: 1 0;
    transition: scale var(--slow) var(--ease);
  }

  .place[aria-pressed='true']::before {
    scale: 1;
  }

  /* Under the stage on small screens, the rail lies down into a row of tabs. */
  @media (max-width: 47.99rem) {
    .rail {
      flex-direction: row;
      width: auto;
      padding: 0 var(--space-3);
      gap: 0;
      border-right: 0;
      border-block: 1px solid var(--line);
    }

    .brand,
    .keys,
    .maker,
    [data-action='install'] {
      display: none;
    }

    ul {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }

    .place {
      width: 100%;
    }

    .place::before {
      inset: auto 30% 0 30%;
      width: auto;
      height: 2px;
      scale: 0 1;
    }
  }
</style>
