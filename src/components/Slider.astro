---
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  min: number;
  max: number;
  step: number;
  value: number;
}

const { id, label, min, max, step, value } = Astro.props;
---

<label class="slider" for={id}>
  <Icon name="volume" />
  <span class="visually-hidden">{label}</span>
  <input type="range" id={id} min={min} max={max} step={step} value={value} />
  <output class="label" id={`${id}-value`} for={id}></output>
</label>

<style>
  .slider {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 4ch;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-muted);
  }

  output {
    text-align: right;
  }

  input {
    --fill: 0%;
    appearance: none;
    width: 100%;
    height: var(--control);
    margin: 0;
    background: linear-gradient(to right, var(--color-text) var(--fill), var(--line) var(--fill)) center /
      100% 2px no-repeat;
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  input::-webkit-slider-thumb {
    appearance: none;
    width: 0.75rem;
    height: 0.75rem;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-text);
    transition: scale var(--fast) var(--ease);
  }

  input:hover::-webkit-slider-thumb {
    scale: 1.3;
  }

  input::-moz-range-thumb {
    width: 0.75rem;
    height: 0.75rem;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-text);
  }

  input::-moz-range-track {
    background: none;
  }
</style>
