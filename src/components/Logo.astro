---
/**
 * The iRadio mark: a lower-case i whose dot is a station on air, with the
 * signal leaving it on both sides.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 48 48" fill="none" role="img" aria-label="iRadio">
  <g stroke="var(--color-text)" stroke-width="2.25" stroke-linecap="round">
    <path d="M30.89 8.21a9 9 0 0 1 0 11.58M17.11 8.21a9 9 0 0 0 0 11.58"></path>
    <path d="M34.72 5a14 14 0 0 1 0 18M13.28 5a14 14 0 0 0 0 18" opacity="0.45"></path>
  </g>
  <rect x="20" y="24" width="8" height="20" rx="4" fill="var(--color-text)"></rect>
  <circle cx="24" cy="14" r="4.5" fill="var(--color-amber)"></circle>
</svg>
